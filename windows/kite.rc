#include <winuser.h>
CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "kite.manifest"
1 ICON "icons/kite.ico"
2 ICON "icons/kite-off.ico"
1 VERSIONINFO
FILEVERSION 0,1,7,0
PRODUCTVERSION 0,1,7,0
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "Bekir Demircioglu"
      VALUE "FileDescription", "Kite DPI"
      VALUE "InternalName", "Kite"
      VALUE "LegalCopyright", "Copyright (c) Bekir Demircioglu. MIT License."
      VALUE "OriginalFilename", "Kite.exe"
      VALUE "ProductName", "Kite DPI"
      VALUE "FileVersion", "0.1.7"
      VALUE "ProductVersion", "0.1.7"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
